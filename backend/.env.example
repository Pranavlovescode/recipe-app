# Google Gemini API Configuration
# Replace with your Google Gemini API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration
# Available models: gemini-pro, gemini-pro-vision
GEMINI_MODEL=gemini-2.0-flash

# Maximum tokens in the response
# Higher values allow for longer cooking instructions (max for gemini-pro is 8192)
GEMINI_MAX_TOKENS=8192